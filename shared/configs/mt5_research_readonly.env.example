# MT5 research read-only mode — template (sanitized copy of configs/mt5_research_readonly.env)
# Load this file before any research MT5 access (set these variables in the
# environment of research processes). tools/mt5_readonly.py fails closed
# without MT5_RESEARCH_READONLY_MODE=1.
#
# NOTE: this is a NON-SECRET config template. Real broker credentials
# (.env.mt5_demo / .env.mt5_v3_calib / .env.v3_jin10) are intentionally
# NOT included in this archive.
MT5_RESEARCH_READONLY_MODE=1
MT5_ORDER_API_DISABLED=1
