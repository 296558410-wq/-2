 },
 "corrected_definition": {
  "feature": "zma = (close_t - SMA_20(close)_t) / ( close_t * sigma_ret_20_t * K_20 )",
  "K_20": 2.484955,
  "K_n_closed_form": "K_n = sqrt( (n-1)(2n-1) / (6n) )",
  "K_n_derivation": "D_t = close_t - SMA_n = (1/n) * sum_{k=1..n-1} (close_t - close_{t-k}); for iid increments with per-bar price variance s_p^2, Cov(close_t-close_{t-k}, close_t-close_{t-l}) = min(k,l) s_p^2, so Var(D) = [sum_{k,l=1..n-1} min(k,l) / n^2] s_p^2 = [(n-1)(2n-1)/(6n)] s_p^2, giving std(D) = s_p * K_n.",
  "sigma_ret_20": "trailing 20-bar std of 1-bar returns, shifted by 1 bar (causal)",
  "units": "numerator is price; denominator is close (price) x dimensionless return-sigma x dimensionless K => the ratio is dimensionless. Units were already consistent in F-R1; ONLY the scale constant was wrong.",
  "frozen_definition_for_comparison": "F-R1 used K = sqrt(20) = 4.472136, i.e. the denominator was 1.799685x too wide (80.0% too wide).",
  "limits": [
   "assumes locally iid, zero-drift increments and a constant sigma across the 20-bar window",
   "sigma is estimated from returns but applied to a price-scale deviation; a Student-t style adjustment for the sigma-estimation error is NOT included (kept simple and pre-registered)"
  ]
 },
