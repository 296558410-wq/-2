{
 "schema": "v3_opportunity_schema/1",
 "required": [
  "opportunity_id",
  "detected_at",
  "opportunity_type",
  "market_state",
  "trigger_features",
  "feature_values",
  "data_sources",
  "context_hash",
  "detection_version",
  "scores",
  "cluster_id",
  "is_cluster_continuation",
  "trigger",
  "data_quality"
 ],
 "observation_fields_separate": [
  "post_event_observation (never used by detection)"
 ],
 "forbidden_fields": [
  "profit_score",
  "win_probability",
  "expected_profit",
  "signal",
  "order",
  "position"
 ]
}